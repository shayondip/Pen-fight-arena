# Pen Fight Arena - environment template
#
# Copy this file to ".env" and edit as needed. setup.bat does the copy for you.
# Nothing here is a real secret; .env itself is gitignored.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the game server (REST API + Socket.IO) listens on.
PORT=4000

# Interface to bind. 0.0.0.0 also accepts connections from other devices on
# your LAN, which is how you test on a phone. Use 127.0.0.1 to stay local-only.
HOST=0.0.0.0

# Port the Vite dev server uses for the browser client.
CLIENT_PORT=5173

# Base URL used to build shareable invite links. In local development this is
# the Vite dev server, because that is the address a friend would open.
# In production set it to your deployed site, e.g. https://penfight.example.com
PUBLIC_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API.
# Leave empty for local development (any origin is accepted).
# In production, list your real site: https://penfight.example.com
CORS_ORIGINS=

# Set to true to have the API server also serve the built client from
# client/dist. Useful for a single-service deployment. Run "npm run build" first.
SERVE_CLIENT=false

# Where the local development store writes its JSON file, relative to server/.
DATA_DIR=.data

# Set to true for verbose per-socket logging.
PFA_DEBUG=false

# ---------------------------------------------------------------------------
# Database (optional)
# ---------------------------------------------------------------------------
#
# Leave DATABASE_URL commented out and the game runs on a local JSON file:
# everything works, but accounts and rankings live on this machine only, and
# the UI says so.
#
# Uncomment and point it at a real PostgreSQL instance to get persistent
# accounts, shared match history and a genuine worldwide leaderboard. Then run:
#
#   npm run prisma:generate
#   npm run prisma:push
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/penfight?schema=public

# Force the local JSON store even when DATABASE_URL is set. Handy for offline work.
DISABLE_DATABASE=false

# ---------------------------------------------------------------------------
# Client build (optional)
# ---------------------------------------------------------------------------
#
# Only needed when the client is hosted somewhere other than the game server,
# for example the client on Netlify and the server on Railway. In local
# development leave this unset: Vite proxies /api and /socket.io for you.
#
# VITE_SERVER_URL=https://penfight-server.example.com
